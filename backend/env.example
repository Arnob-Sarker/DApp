# MongoDB Configuration
# For local MongoDB:
MONGODB_URI=mongodb://localhost:27017/registration_system

# For MongoDB Atlas (uncomment and replace with your connection string):
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/registration_system?retryWrites=true&w=majority

# Web3 Configuration
WEB3_PROVIDER=http://localhost:8545
CONTRACT_ADDRESS=your-deployed-contract-address

# Email Configuration (Gmail)
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# Server Configuration
PORT=3001
FRONTEND_URL=http://localhost:3000

# Security Configuration
HASH_SALT=your-secure-random-salt-for-hashing-personal-data
